# THE WAY OUT Agent v2.0 — مثال متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة:
#   Windows PowerShell:  copy .env.example .env
#   Linux/macOS:         cp .env.example .env

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_NUM_CTX=8192
AGENT_MAX_STEPS=8
AGENT_TIMEOUT=60
AGENT_TOOLSET=full
DEFAULT_PORT=5000
MEMORY_FILE=memory.json
