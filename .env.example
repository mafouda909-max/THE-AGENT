# THE WAY OUT Agent v2.0 — مثال متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة:
#   Windows PowerShell:  copy .env.example .env
#   Linux/macOS:         cp .env.example .env

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_NUM_CTX=8192
AGENT_MAX_STEPS=8
AGENT_TIMEOUT=60
AGENT_TOOLSET=full
DEFAULT_PORT=5000
MEMORY_FILE=memory.json

# --- Frontier اختياري (موديلات قوية بخطط مجانية — يفعّل use_frontier_model و battle_models) ---
# OpenRouter: مفتاح من https://openrouter.ai/keys
# AGENT_BRAIN: auto (قوي لو المفتاح موجود) | local (Ollama فقط) | frontier (قوي إجبارياً)
AGENT_BRAIN=auto
FRONTIER_API_KEY=
FRONTIER_BASE_URL=https://openrouter.ai/api/v1
FRONTIER_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# بدائل (بدّل القيمتين):
# Groq (سريع):      FRONTIER_BASE_URL=https://api.groq.com/openai/v1 + FRONTIER_MODEL=llama-3.3-70b-versatile
# Gemini (حصة كبيرة): FRONTIER_BASE_URL=https://generativelanguage.googleapis.com/v1beta1/openai + FRONTIER_MODEL=gemini-2.0-flash
